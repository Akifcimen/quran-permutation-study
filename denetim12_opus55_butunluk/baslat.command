#!/bin/zsh
cd "$HOME/opus5.5/butunluk"
exec "$HOME/.local/bin/claude" --model claude-opus-5-5 --effort max "Bu klasördeki GOREV.md dosyasını baştan sona oku ve görevi uygula. ~/Desktop/hrf2 salt okunurdur; bütün çalışma bu klasörde. Aynı anda en çok 4 iş parçacığı kullan. girdi/ altındaki dış kodu çalıştırmadan önce oku. Ön-kaydı hiçbir rastgele kitabın bütünlük puanına bakmadan yaz ve dondur; ana hattın tahminini ön-kayda aynen yaz."
