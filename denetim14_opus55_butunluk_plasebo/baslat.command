#!/bin/zsh
cd "$HOME/opus5.5/plasebo14"
exec "$HOME/.local/bin/claude" --model claude-opus-5-5 --effort max "Bu klasördeki GOREV.md dosyasını baştan sona oku ve görevi uygula. ~/Desktop/hrf2, ~/opus5.5/butunluk, ~/opus5.5/kosullu, ~/opus5.5/plasebo ve ~/opus5.5/plasebo12 salt okunurdur; bütün çalışma bu klasörde. Aynı anda en çok 4 iş parçacığı ya da süreç kullan. Ön-kaydı hiçbir hedefin bu görevin dilleriyle kurulan sonucuna ya da kontrol puanına bakmadan yaz ve dondur; ana hattın tahminini ve okuma kuralını ön-kayda aynen yaz."
